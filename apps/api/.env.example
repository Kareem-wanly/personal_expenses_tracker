# pglite:<folder> runs an embedded PostgreSQL (development only, nothing to install).
# Production: postgres://user:password@host:5432/masrufi
DATABASE_URL=pglite:./.data
# Any random text of 32+ characters.
BETTER_AUTH_SECRET=
API_URL=http://localhost:4000
# Comma separated: the site, the app in a browser, and the app's URL scheme.
# Expo Go also needs: exp://
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8081,masrufi://
PORT=4000
# Set to true only behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Mail (password reset). Without it, development prints mails and production refuses.
SMTP_URL=
MAIL_FROM=
# Web notifications.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# The scheduler calls once a day: POST /jobs/daily, Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Optional sign-in providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_BUNDLE_ID=
