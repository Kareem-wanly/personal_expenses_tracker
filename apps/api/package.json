{
  "name": "@masrufi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=4 \"test/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/database/migrate.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.27",
    "@better-auth/passkey": "^1.7.27",
    "@electric-sql/pglite": "^0.6.0",
    "@hono/node-server": "^2.1.11",
    "better-auth": "^1.7.27",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.21",
    "nodemailer": "^10.6.1",
    "postgres": "^4.1.1",
    "tsx": "^4.23.15",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  }
}
