# ---- Database ----------------------------------------------------------
# Local dev: a SQLite file (no setup needed)
DATABASE_URL=file:local.db
# Production (Turso): libsql://<db-name>-<org>.turso.io
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token

# ---- Auth (Better Auth) ------------------------------------------------
# Generate with: npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-a-random-32+-char-secret
# Public URL of the app (http://localhost:3000 in dev, https://your-app.vercel.app in prod)
BETTER_AUTH_URL=http://localhost:3000
