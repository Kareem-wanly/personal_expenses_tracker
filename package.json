{
  "name": "masrufi",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @masrufi/web",
    "build": "npm run build -w @masrufi/web",
    "start": "npm run start -w @masrufi/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @masrufi/web",
    "db:migrate": "npm run db:migrate -w @masrufi/web",
    "db:studio": "npm run db:studio -w @masrufi/web",
    "db:seed": "npm run db:seed -w @masrufi/web --",
    "brand": "npm run brand -w @masrufi/web"
  }
}
